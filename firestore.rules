rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🛡️ Valida autenticación y dominio corporativo @termales.com.co
    function esUsuarioTermales() {
      return request.auth != null
        && request.auth.token != null
        && 'email' in request.auth.token
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@[tT][eE][rR][mM][aA][lL][eE][sS][.][cC][oO][mM][.][cC][oO]$');
    }

    function esAdmin() {
      return esUsuarioTermales() 
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // 👤 1. Usuarios: lectura del perfil propio y administración para usuarios admin.
    match /usuarios/{userId} {
      allow read: if esAdmin() || (esUsuarioTermales() && request.auth.uid == userId);
      
      // La creación propia conserva el rol básico y no permite asignar permisos o alcance.
      allow create: if esUsuarioTermales() 
        && request.auth.uid == userId 
        && (!request.resource.data.keys().hasAny(['rol']) || request.resource.data.rol == 'lider')
        && request.resource.data.keys().hasOnly([
          'rol', 'nombreResponsable', 'nombre', 'correo', 'email', 'cargo'
        ]);

      // La autogestión se limita a nombre/cargo; permisos y alcance quedan para admin.
      allow update: if esUsuarioTermales() && (
        esAdmin() || (
          request.auth.uid == userId 
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nombreResponsable', 'cargo'
          ])
        )
      );

      allow delete: if esAdmin();
    }

    // 🔒 2. Base de Datos GRC: CIERRE TOTAL CLIENT-SIDE.
    match /workspace_compartido/{docId=**} {
      allow read, write: if false; 
    }

    // 🔒 3. Históricos de Nóminas y Marcaciones: CIERRE TOTAL CLIENT-SIDE.
    match /nominas_historicas/{docId=**} {
      allow read, write, delete: if false;
    }
    
    match /marcaciones_historicas/{docId=**} {
      allow read, write, delete: if false;
    }
  }
}