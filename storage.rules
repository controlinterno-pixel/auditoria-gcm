rules_version = '2';

// 🛡️ REGLAS DE SEGURIDAD - FIREBASE STORAGE - GCM AUDITORÍA
// Permite lectura y escritura solo a usuarios autenticados con Google.
// Los archivos se organizan bajo auditoria/{appName}/{fileName}

service firebase.storage {
  match /b/{bucket}/o {
    
    // Carpeta principal de auditoría GCM
    match /auditoria/{appName}/{allPaths=**} {
      
      // ✅ Solo usuarios autenticados pueden leer y escribir
      allow read, write: if request.auth != null;
      
      // 🛡️ Validaciones adicionales en escritura:
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024   // Máximo 50MB
        && request.resource.contentType.matches('application/pdf|image/.*|application/vnd.openxmlformats.*|application/msword');
    }
  }
}

